# ============================================================
# .env.prod.example — production stack icin sablonu
#
# Kopyala: cp .env.prod.example .env.prod
# Doldur:  asagidaki TODO/RANDOM/CHANGE_ME degerlerini gercek degerlerle
# Calistir: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# UYARI: .env.prod git'e commit ETME. .gitignore'a eklenmis olmali.
# ============================================================

# ── Caddy / TLS ──────────────────────────────────────────
# Let's Encrypt sertifika bildirimleri buraya gider (renewal failure vs.)
ACME_EMAIL=topluluk@divizyon.org

# ── Dashboard Postgres (Prisma) ──────────────────────────
POSTGRES_DB=circle_dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=CHANGE_ME_strong_random
DATABASE_URL=postgresql://dashboard:CHANGE_ME_strong_random@dashboard-postgres:5432/circle_dashboard

# ── Next.js / NextAuth ───────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
NEXTAUTH_URL=https://dashboard.divizyon.org

# ── n8n Postgres ─────────────────────────────────────────
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_strong_random

# ── n8n Auth + Encryption ────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_strong_random
# ESKI volume'u tasiyorsan ESKi N8N_ENCRYPTION_KEY'i kullan, yoksa credentials decode edilemez!
N8N_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_or_keep_old

# ── Dashboard runtime — Supabase ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://jespofhjuorecaetwhww.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Dashboard runtime — n8n entegrasyonu ─────────────────
# Dashboard ici docker network'unde n8n'a ulasir
N8N_API_URL=http://n8n:5678
N8N_MCP_SERVER_URL=https://n8n.divizyon.org/mcp-server/http
N8N_API_KEY=eyJ...
USE_N8N_WEBHOOKS=true

# ── Dashboard runtime — Circle ───────────────────────────
Circle_APIV2_KEY=CHANGE_ME
Circle_API_KEY_V1=CHANGE_ME
CIRCLE_SYNC_ENABLED=true
CIRCLE_COMMUNITY_ID=405377

# ── Dashboard runtime — Resend ───────────────────────────
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=Divizyon <noreply@divizyon.org>
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Dashboard runtime — TypeForm ─────────────────────────
TYPEFORM_API_TOKEN=tfp_CHANGE_ME

# ── Google Sheets (kanonik 5 sheet) ──────────────────────
SHEET_BASVURU=1lz-BE9qvhi9_CspPd5s9AgcWsaKd-eObCFpQPGoIGXg
SHEET_ENVANTER_KARAKTERISTIK=1f1ETjIf1-Z5GupNgX6Z7aXxXXBguLEjLqVzVUv9eh8o
SHEET_ENVANTER_DISIPLINER_URUN=1E4pjzwDb0Bw7zB1SXMjPlzFxe1YL3PA_tCaEicUXuqk
SHEET_ENVANTER_DISIPLINER_KREATIF=1dMoHelSwig5na54JQUEorkQlWVQfQGe6CeCu-P2OEgk
SHEET_ENVANTER_DISIPLINER_DENEYIM=1i39-Sr1BVnEep2XaX8BM1AX5NCqotnrKBLE8dQ6dE0Q

# ── Cron + Webhook Auth ──────────────────────────────────
CRON_SECRET=CHANGE_ME_random_hex
CIRCLE_SYNC_SECRET=CHANGE_ME_random_hex
