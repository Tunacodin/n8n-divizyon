# ============================================================
# .env.local → test ortamı
# .env.production → production (gitignore'da, VPS'e manuel kopyala)
# ============================================================

# n8n Configuration
N8N_API_URL=https://your-n8n-instance.rpcld.net
N8N_MCP_SERVER_URL=https://your-n8n-instance.rpcld.net/mcp-server/http
N8N_API_KEY=your_n8n_api_key

# Circle API
Circle_APIV2_KEY=your_circle_v2_key
Circle_API_KEY_V1=your_circle_v1_key

# Data Source
USE_N8N_WEBHOOKS=true

# Resend
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=Divizyon <noreply@yourdomain.com>
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret  # /api/mail/webhook icin

# Cron (Vercel Cron + n8n schedule paylasir)
CRON_SECRET=long_random_string_for_cron_auth
CIRCLE_SYNC_SECRET=another_random_string_for_circle_sync_endpoint
CIRCLE_COMMUNITY_ID=405377

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# TypeForm
TYPEFORM_API_TOKEN=your_typeform_token

# Google Sheets — Sheet ID'leri (test: .env.local, prod: .env.production)
SHEET_BASVURU=your_sheet_id
SHEET_KONTROL=your_sheet_id
SHEET_YAS_KUCUK=your_sheet_id
SHEET_KESIN_RET=your_sheet_id
SHEET_NIHAI_OLMAYAN=your_sheet_id
SHEET_KESIN_KABUL=your_sheet_id
SHEET_ETKINLIK=your_sheet_id
SHEET_DEAKTIVE=your_sheet_id
SHEET_NIHAI_AG_UYESI=your_sheet_id

# ── Auth Secret ──────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=

# ── Local Postgres (Prisma) ──────────────────────────────
POSTGRES_DB=circle_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@postgres:5432/circle_dashboard
